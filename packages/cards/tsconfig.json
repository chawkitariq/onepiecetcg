{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "declaration": true,
    "strict": true,
    "types": ["node"],
    "useDefineForClassFields": false,
    "outDir": "dist",
    "declarationDir": "dist",
    "rootDir": ".",
    "skipLibCheck": true,
    "noImplicitAny": false
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "src/effects/test-utils.ts"
  ]
}
