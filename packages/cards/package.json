{
  "name": "@onepiecetcg/cards",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./effects": {
      "types": "./effects/index.ts",
      "import": "./effects/index.ts",
      "default": "./effects/index.ts"
    },
    "./effects/*": {
      "types": "./effects/*.ts",
      "import": "./effects/*.ts",
      "default": "./effects/*.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "test": "../web/node_modules/.bin/vitest",
    "test:run": "../web/node_modules/.bin/vitest run --config ./vitest.config.ts"
  },
  "dependencies": {
    "@onepiecetcg/shared": "workspace:*"
  }
}
